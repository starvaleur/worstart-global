+import { Link } from 'wouter';
+import { Layout } from '@/components/site/layout';
+import { StoreLink } from '@/components/site/store-link';
+import { Badge, Button, SectionHeader } from '@/components/site/ds';
+import { storeConfigured } from '@/lib/config';
+import { openEnquiry } from '@/lib/config';
+
+export default function Shop() {
+  const ok = storeConfigured();
+  return (
+    <Layout><div className="page-shell container-wide">
+      <SectionHeader eyebrow="The store" title="Shop the WORSTARTGLOBAL store." body="Products, cart, checkout and store orders are handled by our Shopify storefront, not by this website." />
+      <div className="mt-12 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
+        <div>
+          {ok ? <StoreLink className="button-primary">Open the store</StoreLink> : <div role="status" className="border-l-2 border-[hsl(var(--accent))] pl-4"><Badge tone="warn">Store link pending</Badge><p className="mt-3 max-w-md text-sm leading-6 text-[hsl(var(--muted-foreground))]">The storefront link is being connected and is not available from this site yet. There are no products to buy here. Ask us and we will point you to the store when it is ready.</p><Button className="mt-5" variant="secondary" onClick={() => openEnquiry({ service: 'E-commerce / DZ Seller', description: 'Please send me the store link.' })}>Ask about the store</Button></div>}
+        </div>
+        <ul className="space-y-4 text-sm leading-6 text-[hsl(var(--muted-foreground))]">
+          <li><strong className="text-[hsl(var(--foreground))]">Checkout &amp; payment</strong> happen on Shopify. Available payment methods are shown there, not here.</li>
+          <li><strong className="text-[hsl(var(--foreground))]">Store orders</strong> and tracking emails come from the store. For freight, vehicles or customs, use a <Link href="/#contact" className="underline">logistics enquiry</Link>.</li>
+        </ul>
+      </div>
+    </div></Layout>
+  );
+}
+
+export function Orders() {
+  return (
+    <Layout><div className="page-shell container-wide max-w-3xl">
+      <SectionHeader eyebrow="Orders" title="Where are my orders?" body="Store orders are managed by Shopify. Freight and logistics requests are answered by email after you submit an enquiry." />
+      <div className="mt-8 flex flex-wrap gap-3"><StoreLink className="button-primary">Shop the Store</StoreLink><Link href="/#tracking" className="button-secondary">Shipment visibility</Link></div>
+    </div></Layout>
+  );
+}
+
+export function Seller() {
+  return (
+    <Layout><div className="page-shell container-wide max-w-3xl">
+      <SectionHeader eyebrow="DZ Seller" title="Sell globally. WORSTART handles the route." body="Seller onboarding is not live. Register your interest and we will contact you by email." />
+      <Button className="mt-8" onClick={() => openEnquiry({ service: 'E-commerce / DZ Seller' })}>Register seller interest</Button>
+    </div></Layout>
