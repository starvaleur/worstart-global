+import type { ReactNode } from 'react';
+import { ArrowUpRight } from 'lucide-react';
+import { storeUrl, storeConfigured } from '@/lib/config';
+
+/** Opens the Shopify storefront when configured; otherwise goes to /shop, which explains the link is being connected. */
+export function StoreLink({ children = 'Shop the Store', className = '', path = '', onClick }: { children?: ReactNode; className?: string; path?: string; onClick?: () => void }) {
+  const ok = storeConfigured();
+  return (
+    <a href={ok ? `${storeUrl}${path}` : '/shop'} {...(ok ? { target: '_blank', rel: 'noopener noreferrer' } : {})} className={className} onClick={onClick} data-testid="link-store">
+      {children}<ArrowUpRight className="h-4 w-4 shrink-0" />{ok && <span className="sr-only"> (opens in a new tab)</span>}
+    </a>
+  );
+}
