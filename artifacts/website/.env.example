# Public (browser) — enquiries are sent via Formspree only when this is set.
VITE_FORMSPREE_FORM_ID=
# Shopify storefront URL, e.g. https://your-store.myshopify.com or your custom domain (https only).
VITE_SHOPIFY_STORE_URL=
# Optional: set when these storefronts are live. Until then the Store Directory shows enquiry options.
VITE_AUTO_STORE_URL=
VITE_MACHINERY_STORE_URL=
